# Copy to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...

# Path to the raw dataset (local, not committed)
DATASET_PATH=/path/to/dataset.csv.zst

# SQLite DB path (created by pipeline/ingest.py)
DB_PATH=data/orgs.db

# FastAPI backend URL (used by the Streamlit app)
API_BASE_URL=http://localhost:8000
